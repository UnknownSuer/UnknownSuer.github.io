# Публичный URL сайта (для метаданных, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://amigokiz.ru

# Подпуть для GitHub Pages project-репозитория (например /angar.github.io).
# Задаётся автоматически в .github/workflows/deploy.yml — вручную не нужен.
NEXT_PUBLIC_BASE_PATH=

# Embed-ссылка виджета 2ГИС для карты на странице «Контакты».
# Пока не задана — показывается карта с точкой 43.199864, 46.863486 и ссылкой на 2ГИС.
NEXT_PUBLIC_2GIS_EMBED_URL=

# ── Панель управления /admin ───────────────────────────────────────
# SHA-256 пароля админки. Пока пусто — админка не открывается ни у кого.
# Как посчитать хеш и куда его класть — см. ADMIN.md.
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" 'ВАШ-ПАРОЛЬ'
NEXT_PUBLIC_ADMIN_PASS_HASH=

# ── Приём заявок ───────────────────────────────────────────────────
# Куда POST-ить заявки и брифы. По умолчанию /api/leads — он работает только
# при запуске с Node-сервером; на статическом хостинге роут не существует,
# поэтому здесь указывается свой бэкенд, CRM или форм-сервис.
NEXT_PUBLIC_LEADS_ENDPOINT=

# ── Личный кабинет ─────────────────────────────────────────────────
# База API боевой авторизации ученика (телефон покупки + код из SMS).
# Пусто — кабинет работает на кодах доступа из админки.
# Ожидаются POST /auth/request-code и POST /auth/verify-code,
# контракт: src/features/student-auth/phone-otp-auth.ts
NEXT_PUBLIC_STUDENT_API=

# ── Интеграции следующих фаз (см. README) ──────────────────────────
# DIRECTUS_URL=http://localhost:8055
# DIRECTUS_STATIC_TOKEN=
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Local/VPS storage for brief attachments
BRIEF_UPLOAD_DIR=./storage/brief-uploads
