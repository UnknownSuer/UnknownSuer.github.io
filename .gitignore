# ── Зависимости ───────────────────────────────────────────────────
node_modules/

# ── Сборка Next.js ────────────────────────────────────────────────
.next/
out/
build/
# Генерируется самим Next при каждом dev/build и переписывается
# по-разному после `next dev` и `next build` — в репозитории не нужен
# (так же настроено в шаблоне create-next-app).
next-env.d.ts

# ── Тесты ─────────────────────────────────────────────────────────
coverage/

# ── Секреты и переменные окружения ────────────────────────────────
# .env.local хранит NEXT_PUBLIC_ADMIN_PASS_HASH (хеш пароля админки).
# В репозиторий уезжает только шаблон .env.example без значений.
.env
.env.*
!.env.example

# Ключи, сертификаты и файлы с учётными данными
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.keystore
*.jks
secrets.json
secrets.*.json
*.secret
.secrets/
credentials.json
service-account*.json

# ── Персональные данные и загрузки ────────────────────────────────
# Заявки, брифы и вложения локального мок-бэкенда /api/leads — там ПДн
# посетителей (имя, телефон, почта), публиковать нельзя.
storage/
uploads/
*.sqlite
*.sqlite3
*.db
dump*.sql
*.sql.gz

# ── Артефакты сборки ──────────────────────────────────────────────
# Копия контент-пака, создаётся прибилдом (scripts/sync-content-overlay.mjs).
public/content/
tsconfig.tsbuildinfo
*.tsbuildinfo
.eslintcache

# ── Внутренние документы, не для публичного репозитория ───────────
/ОБЗОР-КОДА.md
/ADMIN.md
# ── Локальные настройки инструментов ──────────────────────────────
# Воркtree Claude Code лежат внутри проекта — это отдельные чекауты.
.claude/worktrees/
.claude/settings.local.json
.claude/*.local.json
.vercel/
.turbo/
.idea/
.vscode/

# ── Логи ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── ОС ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Резервные копии и мусор редакторов ────────────────────────────
*.bak
*.orig
*.rej
*~
